<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TrophyShots.App.ViewModels"
        xmlns:controls="clr-namespace:TrophyShots.App.Controls"
        x:Class="TrophyShots.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="TrophyShots"
        Width="1440" Height="900"
        MinWidth="1100" MinHeight="700"
        Background="#12141A">

  <Window.Styles>
    <Style Selector="Button.tool">
      <Setter Property="MinWidth" Value="76" />
      <Setter Property="Padding" Value="12,7" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Padding" Value="16,7" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- 顶部：目录与进度 -->
    <Border Grid.Row="0" Padding="14,10" Background="#191C24" BorderBrush="#262B36" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
        <Button Grid.Column="0" Classes="tool" Content="选择录像目录…" Command="{Binding ChooseDirectoryCommand}" />
        <Button Grid.Column="1" Classes="tool" Margin="8,0,0,0" Content="重新扫描" Command="{Binding RescanCommand}" />
        <Button Grid.Column="2" Classes="tool" Margin="8,0,0,0" Content="查看汇总" Command="{Binding ShowSummaryCommand}" />
        <Button Grid.Column="3" Classes="tool" Margin="8,0,0,0" Content="重启播放器" Command="{Binding RestartPlayerCommand}" />
        <TextBlock Grid.Column="4" Margin="16,0" VerticalAlignment="Center"
                   Text="{Binding DirectoryPath}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="5" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding ProgressText}" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="360,*">

      <!-- 左：录像列表 -->
      <Border Grid.Column="0" BorderBrush="#262B36" BorderThickness="0,0,1,0">
        <ListBox x:Name="VideoList"
                 ItemsSource="{Binding Videos}"
                 SelectedItem="{Binding SelectedVideo}"
                 Background="Transparent"
                 Padding="6">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:VideoItemViewModel">
              <Grid ColumnDefinitions="*,Auto" Margin="4,3">
                <StackPanel Grid.Column="0" Spacing="2">
                  <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding DetailText}" FontSize="11" Opacity="0.55" />
                </StackPanel>
                <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="9" Padding="8,2"
                        Background="#22FFFFFF">
                  <TextBlock Text="{Binding StatusText}" FontSize="11" />
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <!-- 右：播放器与操作 -->
      <Grid Grid.Column="1" RowDefinitions="*,Auto,Auto">

        <Border Grid.Row="0" Background="Black">
          <controls:MpvHostControl x:Name="VideoHost" />
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="16,12,16,6">
          <Slider x:Name="Timeline" Grid.Column="0"
                  Minimum="0"
                  Maximum="{Binding DurationSeconds}"
                  Value="{Binding PositionSeconds, Mode=OneWay}"
                  VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding PositionText}" FontFamily="Consolas, Microsoft YaHei UI" />
            <TextBlock Text="{Binding FrameText}" FontSize="11" Opacity="0.6" FontFamily="Consolas, Microsoft YaHei UI" />
            <TextBlock Text="非常帧率：按时间步进" FontSize="11" Foreground="#E8C07A"
                       IsVisible="{Binding IsTimeBasedStepping}" />
          </StackPanel>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="16,0,16,14">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
            <Button Classes="tool" Content="−10 帧" Command="{Binding StepBackwardTenCommand}" />
            <Button Classes="tool" Content="−1 帧" Command="{Binding StepBackwardCommand}" />
            <Button Classes="tool" Content="播放 / 暂停" Command="{Binding TogglePlayCommand}" />
            <Button Classes="tool" Content="+1 帧" Command="{Binding StepForwardCommand}" />
            <Button Classes="tool" Content="+10 帧" Command="{Binding StepForwardTenCommand}" />
            <Button Classes="tool" Content="−1 秒" Command="{Binding SecondBackwardCommand}" />
            <Button Classes="tool" Content="+1 秒" Command="{Binding SecondForwardCommand}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <Button Classes="tool" Content="重截当前" Command="{Binding RecaptureCommand}" />
            <Button Classes="primary" Content="截图并下一条" Command="{Binding CaptureCommand}" />
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>

    <!-- 底部：状态 -->
    <Border Grid.Row="2" Padding="14,7" Background="#191C24" BorderBrush="#262B36" BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding StatusMessage}" Foreground="#C9CFD8" TextTrimming="CharacterEllipsis" />
    </Border>
  </Grid>
</Window>
