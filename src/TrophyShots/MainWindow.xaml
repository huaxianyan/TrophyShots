<Window x:Class="TrophyShots.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mpv="clr-namespace:TrophyShots.Mpv"
        Title="TrophyShots M0" Height="820" Width="1320"
        Background="#FF141414"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded"
        Closing="OnClosing"
        SizeChanged="OnSizeChanged"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="Black">
            <mpv:MpvHost x:Name="VideoHost" Focusable="False" />
        </Border>

        <Border Grid.Row="1" Background="#FF1F1F1F" Padding="12,8">
            <TextBlock x:Name="StatusText" Foreground="#FFEDEDED" FontFamily="Consolas, Microsoft YaHei UI"
                       TextTrimming="CharacterEllipsis" Text="正在准备 mpv…" />
        </Border>

        <Border Grid.Row="2" Background="#FF1F1F1F" Padding="12,8">
            <TextBlock x:Name="HintText" Foreground="#FF9A9A9A" FontFamily="Consolas, Microsoft YaHei UI"
                       TextTrimming="CharacterEllipsis"
                       Text="←/→ 逐帧　Shift+←/→ 十帧　空格 播放/暂停　S 截图　F12 抓屏取证" />
        </Border>
    </Grid>
</Window>
